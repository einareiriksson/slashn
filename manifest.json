{
  "manifest_version": 3,
  "name": "slashn",
  "version": "1.2.1",
  "description": "Launch SAP Fiori apps and classic transactions by alias or t-code: address bar, toolbar or Alt+Shift+S, on cloud and on-premise.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "omnibox": {
    "keyword": "s"
  },
  "permissions": [
    "storage",
    "offscreen",
    "clipboardWrite",
    "scripting",
    "unlimitedStorage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://*.s4hana.cloud.sap/*"
  ],
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.s4hana.cloud.sap/ui*"
      ],
      "js": [
        "src/content-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.s4hana.cloud.sap/ui*"
      ],
      "js": [
        "src/content-isolated.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "slashn",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "commands": {
    "open-launcher": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Open the slashn launcher (an overlay on the page, or a centred window where the page cannot be scripted)"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/popup/popup.html"
      ],
      "matches": [
        "https://*/*",
        "http://*/*"
      ]
    }
  ]
}
